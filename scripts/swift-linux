#!/bin/bash
set -euo pipefail
mkdir -p /workspace/watchweeks-tools/cache
exec env -u DOCKER_HOST -u DOCKER_CONTEXT -u DOCKER_TLS -u DOCKER_TLS_VERIFY -u DOCKER_CERT_PATH docker --host=unix:///var/run/docker.sock run --rm --init --user "$(id -u):$(id -g)" --mount type=bind,src=/workspace,dst=/workspace --workdir "$PWD" -e HOME=/workspace/watchweeks-tools/cache swift@sha256:0e4716bd34384d22963a63afbdbc93be3129dfd0753185aa1ded27755abdcae8 swift "$@"
